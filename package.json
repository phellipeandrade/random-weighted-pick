{
  "name": "random-weighted-pick",
  "version": "2.0.0",
  "description": "A lightweight, zero-dependency utility for weighted random selection with TypeScript support",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "rollup -c",
    "build:watch": "rollup -c -w",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "format:check": "prettier --check src/**/*.ts",
    "type-check": "tsc --noEmit",
    "prepare": "npm run build",
    "prepublishOnly": "npm run test && npm run lint && npm run type-check"
  },
  "keywords": [
    "random",
    "weighted",
    "selection",
    "probability",
    "typescript",
    "zero-dependency",
    "utility",
    "library"
  ],
  "author": {
    "name": "Phellipe Andrade",
    "email": "phellipeandrade@gmail.com",
    "url": "https://github.com/phellipeandrade"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phellipeandrade/random-weighted-pick.git"
  },
  "bugs": {
    "url": "https://github.com/phellipeandrade/random-weighted-pick/issues"
  },
  "homepage": "https://github.com/phellipeandrade/random-weighted-pick#readme",
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-typescript": "^11.1.5",
    "@types/jest": "^29.5.8",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "bundlesize": "^0.18.1",
    "codecov": "^3.8.3",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "lint-staged": "^15.1.0",
    "prettier": "^3.1.0",
    "rollup": "^4.6.1",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.2"
  },
  "dependencies": {},
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  }
}
